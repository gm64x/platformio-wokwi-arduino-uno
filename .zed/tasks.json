// Zed tasks for PlatformIO + Wokwi.
// Run them with `task: spawn` (alt-shift-t) or rerun the last one with `task: rerun` (alt-t).
// See https://zed.dev/docs/tasks
[
  {
    "label": "PlatformIO: Build",
    "command": "pio",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["pio"]
  },
  {
    "label": "PlatformIO: Upload",
    "command": "pio",
    "args": ["run", "--target", "upload"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["pio"]
  },
  {
    "label": "PlatformIO: Upload and Monitor",
    "command": "pio",
    "args": ["run", "--target", "upload", "--target", "monitor"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "tags": ["pio"]
  },
  {
    "label": "PlatformIO: Serial Monitor",
    "command": "pio",
    "args": ["device", "monitor"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "tags": ["pio"]
  },
  {
    "label": "PlatformIO: Clean",
    "command": "pio",
    "args": ["run", "--target", "clean"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["pio"]
  },
  {
    "label": "PlatformIO: Test",
    "command": "pio",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["pio"]
  },
  {
    "label": "PlatformIO: Generate compile_commands.json (clangd)",
    "command": "pio",
    "args": ["run", "--target", "compiledb"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "tags": ["pio"]
  },
  {
    "label": "Wokwi: Simulate",
    "command": "wokwi-cli",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "tags": ["wokwi"]
  }
]
